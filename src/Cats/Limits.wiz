import Cats.Constructions
-- Isomorphisms and limits: terminal objects, binary products, equalisers, pullbacks, each
-- as an object with its universal property; their uniqueness up to isomorphism; and the
-- limits of the category of types.

-- ## Isomorphisms

structure Iso.{u, v} (C : Category.{u, v}) (X Y : C.Obj) : Type v where
  hom : C.Hom X Y
  inv : C.Hom Y X
  hom_inv : C.comp hom inv = C.id X
  inv_hom : C.comp inv hom = C.id Y

def Iso.refl.{u, v} (C : Category.{u, v}) (X : C.Obj) : Iso C X X :=
  Iso.mk (C.id X) (C.id X) (C.id_comp (C.id X)) (C.id_comp (C.id X))
def Iso.symm.{u, v} {C : Category.{u, v}} {X Y : C.Obj} (i : Iso C X Y) : Iso C Y X :=
  Iso.mk i.inv i.hom i.inv_hom i.hom_inv

-- ## Terminal objects

structure Terminal.{u, v} (C : Category.{u, v}) : Type (max u v) where
  obj : C.Obj
  lift : (X : C.Obj) → C.Hom X obj
  uniq : {X : C.Obj} → (0 f : C.Hom X obj) → f = lift X

-- any two morphisms into a terminal object are equal
def Terminal.hom_ext.{u, v} {C : Category.{u, v}} (T : Terminal C) {X : C.Obj} (0 f g : C.Hom X T.obj) : f = g :=
  eqTrans (T.uniq f) (eqSymm (T.uniq g))

-- two terminal objects are isomorphic
def Terminal.unique.{u, v} {ω C : Category.{u, v}} (S T : Terminal C) : Iso C S.obj T.obj :=
  Iso.mk (T.lift S.obj) (S.lift T.obj)
    (Terminal.hom_ext S (C.comp (T.lift S.obj) (S.lift T.obj)) (C.id S.obj))
    (Terminal.hom_ext T (C.comp (S.lift T.obj) (T.lift S.obj)) (C.id T.obj))

-- ## Binary products

structure Product.{u, v} (C : Category.{u, v}) (X Y : C.Obj) : Type (max u v) where
  obj : C.Obj
  fst : C.Hom obj X
  snd : C.Hom obj Y
  pair : {Z : C.Obj} → C.Hom Z X → C.Hom Z Y → C.Hom Z obj
  pair_fst : {Z : C.Obj} → (0 f : C.Hom Z X) → (0 g : C.Hom Z Y) → C.comp (pair f g) fst = f
  pair_snd : {Z : C.Obj} → (0 f : C.Hom Z X) → (0 g : C.Hom Z Y) → C.comp (pair f g) snd = g
  uniq : {Z : C.Obj} → (0 h : C.Hom Z obj) → h = pair (C.comp h fst) (C.comp h snd)

-- ## Equalisers

structure Equaliser.{u, v} (C : Category.{u, v}) {X Y : C.Obj} (f g : C.Hom X Y) : Type (max u v) where
  obj : C.Obj
  ι : C.Hom obj X
  cond : C.comp ι f = C.comp ι g
  lift : {Z : C.Obj} → (h : C.Hom Z X) → (C.comp h f = C.comp h g) → C.Hom Z obj
  lift_ι : {Z : C.Obj} → (0 h : C.Hom Z X) → (0 e : C.comp h f = C.comp h g) → C.comp (lift h e) ι = h
  uniq : {Z : C.Obj} → (0 k : C.Hom Z obj) → k = lift (C.comp k ι) (eqTrans.{v} (C.assoc k ι f)
    (eqTrans.{v} (eqCongr.{v, v} (fun m => C.comp k m) cond) (eqSymm.{v} (C.assoc k ι g))))

-- ## Pullbacks

structure Pullback.{u, v} (C : Category.{u, v}) {X Y Z : C.Obj} (f : C.Hom X Z) (g : C.Hom Y Z) : Type (max u v) where
  obj : C.Obj
  π₁ : C.Hom obj X
  π₂ : C.Hom obj Y
  cond : C.comp π₁ f = C.comp π₂ g
  lift : {W : C.Obj} → (h : C.Hom W X) → (k : C.Hom W Y) → (C.comp h f = C.comp k g) → C.Hom W obj
  lift_π₁ : {W : C.Obj} → (0 h : C.Hom W X) → (0 k : C.Hom W Y) → (0 e : C.comp h f = C.comp k g) → C.comp (lift h k e) π₁ = h
  lift_π₂ : {W : C.Obj} → (0 h : C.Hom W X) → (0 k : C.Hom W Y) → (0 e : C.comp h f = C.comp k g) → C.comp (lift h k e) π₂ = k
  uniq : {W : C.Obj} → (0 m : C.Hom W obj) → m = lift (C.comp m π₁) (C.comp m π₂) (eqTrans.{v} (C.assoc m π₁ f)
    (eqTrans.{v} (eqCongr.{v, v} (fun n => C.comp m n) cond) (eqSymm.{v} (C.assoc m π₂ g))))

-- ## The limits of the category of types

def Types.terminal.{u} : Terminal Types.{u} :=
  Terminal.mk Unit.{u+1} (fun X x => ()) (fun f => rfl)

def Types.product.{u} (A B : Type u) : Product Types.{u} A B :=
  Product.mk (A × B) (fun p => p.1) (fun p => p.2) (fun f g z => (f z, g z))
    (fun f g => rfl) (fun f g => rfl) (fun h => rfl)

-- the proofs in the elements of a subtype. The equation `ι ≫ f = ι ≫ g` in `Types`
-- computes to `(0 p : E) → f p.1 = g p.1`, whose erased `p` can't be projected even in a
-- proof (FINDINGS.md, B2); this function, with an unerased binder, is accepted for it
-- by subtyping (a Π that is a proposition ignores quantities).
def sigmaProp.{u} {A : Type u} {0 P : A → Prop} : (p : (a : A) × P a) → P p.1 := fun p => p.2

-- (the binder types are written: the expected types of the later fields still have a
-- hole for `obj`, FINDINGS.md, P9)
def Types.equaliser.{u} {A B : Type u} (f g : A → B) : Equaliser Types.{u} f g :=
  let E : Type u := (a : A) × (f a = g a);
  Equaliser.mk (C := Types) (f := f) (g := g) E (fun p => p.1) (sigmaProp (P := fun a => f a = g a))
    (fun h e z => ⟨h z, e z⟩) (fun h e => rfl) (fun k => rfl)

def Types.pullback.{u} {A B C : Type u} (f : A → C) (g : B → C) : Pullback Types.{u} f g :=
  -- (`AB`: the level unifier can't solve `?u+1 = max (u+1) (u+1)`, FINDINGS.md, B4)
  let AB : Type u := A × B;
  let P : Type u := (p : AB) × (f p.1 = g p.2);
  Pullback.mk (C := Types) (f := f) (g := g) P (fun p => p.1.1) (fun p => p.1.2) (sigmaProp (A := AB) (P := fun p => f p.1 = g p.2))
    (fun h k e w => ⟨(h w, k w), e w⟩) (fun h k e => rfl) (fun h k e => rfl) (fun m => rfl)

-- ## Products are unique up to isomorphism

-- two morphisms into a product are equal when their components are
def Product.hom_ext.{u, v} {C : Category.{u, v}} {X Y : C.Obj} (P : Product C X Y) {Z : C.Obj}
    (0 h k : C.Hom Z P.obj) (0 e₁ : C.comp h P.fst = C.comp k P.fst) (0 e₂ : C.comp h P.snd = C.comp k P.snd) : h = k :=
  eqTrans (P.uniq h)
    (eqTrans (eqCongr2 (fun a b => P.pair a b) e₁ e₂) (eqSymm (P.uniq k)))

-- `i ≫ j ≫ P.fst = P.fst` when `j ≫ P.fst = Q.fst` and `i ≫ Q.fst = P.fst`
def Category.comp_comp_eq.{u, v} {ω C : Category.{u, v}} {W X Y Z : C.Obj}
    (0 i : C.Hom W X) (0 j : C.Hom X Y) (0 p : C.Hom Y Z) (0 q : C.Hom X Z) (0 r : C.Hom W Z)
    (0 e₁ : C.comp j p = q) (0 e₂ : C.comp i q = r) : C.comp (C.comp i j) p = C.comp (C.id W) r :=
  eqTrans (C.assoc i j p)
    (eqTrans (eqCongr (fun m => C.comp i m) e₁)
      (eqTrans e₂ (eqSymm (C.id_comp r))))

def Product.unique.{u, v} {ω C : Category.{u, v}} {X Y : C.Obj} (P Q : Product C X Y) : Iso C P.obj Q.obj :=
  Iso.mk (Q.pair P.fst P.snd) (P.pair Q.fst Q.snd)
    (Product.hom_ext P _ _
      (Category.comp_comp_eq _ _ _ _ _ (P.pair_fst Q.fst Q.snd) (Q.pair_fst P.fst P.snd))
      (Category.comp_comp_eq _ _ _ _ _ (P.pair_snd Q.fst Q.snd) (Q.pair_snd P.fst P.snd)))
    (Product.hom_ext Q _ _
      (Category.comp_comp_eq _ _ _ _ _ (Q.pair_fst P.fst P.snd) (P.pair_fst Q.fst Q.snd))
      (Category.comp_comp_eq _ _ _ _ _ (Q.pair_snd P.fst P.snd) (P.pair_snd Q.fst Q.snd)))
